      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\n\n// Group flat stop rows back into one item per driver\nconst byDriver = {};\nfor (const r of rows) {\n  if (!byDriver[r.driver_id]) {\n    byDriver[r.driver_id] = {\n      driver_id: r.driver_id,\n      driver_name: r.driver_name,\n      stops: []\n    };\n  }\n  byDriver[r.driver_id].stops.push({\n    order_id: r.order_id,\n    stop_address: r.stop_address,\n    estimated_arrival: r.estimated_arrival,\n    sequence: r.sequence\n  });\n}\n\n// Get phone numbers from Fleet data\nconst fleet = $items('Combined Data')[0].json.fleet;\nconst phoneLookup = {};\nfor (const f of fleet) {\n  phoneLookup[f.driver_id] = f.driver_phone;\n}\n\nreturn Object.values(byDriver).map(d => ({\n  json: {\n    driver_id: d.driver_id,\n    driver_name: d.driver_name,\n    driver_phone: phoneLookup[d.driver_id],\n    stop_count: d.stops.length,\n    first_stop_time: d.stops[0]?.estimated_arrival || '',\n    stops_summary: d.stops.map(s => `${s.sequence}. ${s.stop_address} (${s.estimated_arrival})`).join(' | ')\n  }\n}));"

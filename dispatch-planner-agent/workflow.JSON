    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst parts = j?.content?.parts;\nconst partsText = Array.isArray(parts)\n  ? parts.map(p => (typeof p?.text === 'string' ? p.text : '')).join('')\n  : null;\nconst raw = (partsText && partsText.length ? partsText : null) ?? (typeof j.content === 'string' ? j.content : null) ?? j.text ?? j.output;\n\nif (typeof raw !== 'string') {\n  return [{\n    json: {\n      parse_error: true,\n      error_message: 'Model response text was not found or not a string',\n      raw_response: j\n    }\n  }];\n}\n\nlet cleaned = raw.trim();\n// Strip markdown code fences if Gemini added them anyway\ncleaned = cleaned.replace(/^```json\\s*/i, '').replace(/^```\\s*/i, '').replace(/```\\s*$/i, '');\n\nlet plan;\ntry {\n  plan = JSON.parse(cleaned);\n} catch (err) {\n  return [{\n    json: {\n      parse_error: true,\n      error_message: err.message,\n      raw_response: raw\n    }\n  }];\n}\n\nreturn [{ json: { parse_error: false, ...plan } }];"
      },
      "id": "b7fa45da-5c3e-4dbf-9e5f-a5d0868fbbdc",
      "name": "Parse Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1680,
        -1456
      ]
    },
    {
      "parameters": {
        "jsCode": "const plan = $input.first().json;\nconst combined = $items('Combined Data')[0].json;\nconst orders = combined.orders;\n\n// Build a quick lookup: order_id -> address\nconst addressLookup = {};\nfor (const o of orders) {\n  addressLookup[o.order_id] = o.address;\n}\n\nconst today = new Date().toISOString().split('T')[0]; // YYYY-MM-DD\nconst rows = [];\n\nfor (const route of plan.routes) {\n  for (const stop of route.stops) {\n    rows.push({\n      json: {\n        run_date: today,\n        driver_id: route.driver_id,\n        vehicle_id: route.vehicle_id,\n        sequence: stop.sequence,\n        order_id: stop.order_id,\n        stop_address: addressLookup[stop.order_id] || 'ADDRESS NOT FOUND',\n        estimated_arrival: stop.estimated_arrival,\n        status: 'Proposed'\n      }\n    });\n  }\n}\n\nfor (const u of plan.unassigned || []) {\n  rows.push({\n    json: {\n      run_date: today,\n      driver_id: 'UNASSIGNED',\n      vehicle_id: '-',\n      sequence: '-',\n      order_id: u.order_id,\n      stop_address: addressLookup[u.order_id] || 'ADDRESS NOT FOUND',\n      estimated_arrival: '-',\n      status: `Needs review: ${u.reason}`\n    }\n  });\n}\n\nreturn rows;"
      },

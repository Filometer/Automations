    {
      "parameters": {
        "jsCode": "// Input: the flattened rows from \"Flatten routes\" (one item per stop)\nconst rows = $items('Flatten Routes').map(i => i.json);\n\n// Group stops by driver\nconst byDriver = {};\nfor (const r of rows) {\n  if (r.driver_id === 'UNASSIGNED') continue;\n  if (!byDriver[r.driver_id]) byDriver[r.driver_id] = [];\n  byDriver[r.driver_id].push(r);\n}\n\nlet summary = `DISPATCH PLAN — ${rows[0]?.run_date || ''}\\n\\n`;\n\nfor (const [driverId, stops] of Object.entries(byDriver)) {\n  summary += `${driverId} — ${stops.length} stop${stops.length > 1 ? 's' : ''}\\n`;\n  for (const s of stops) {\n    summary += `  ${s.sequence}. ${s.order_id} → ${s.stop_address} (ETA ${s.estimated_arrival})\\n`;\n  }\n  summary += '\\n';\n}\n\nconst unassigned = rows.filter(r => r.driver_id === 'UNASSIGNED');\nif (unassigned.length > 0) {\n  summary += `NEEDS REVIEW (${unassigned.length}):\\n`;\n  for (const u of unassigned) {\n    summary += `  ${u.order_id} — ${u.status}\\n`;\n  }\n}\n\nreturn [{ json: { summaryText: summary } }];"
      },

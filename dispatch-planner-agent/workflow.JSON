        "jsCode": "const flatRows = $items('Flatten Routes').map(i => i.json);\nconst fleet = $items('Combined Data')[0].json.fleet;\n\n// Lookup: driver_id -> driver_name\nconst nameLookup = {};\nfor (const f of fleet) {\n  nameLookup[f.driver_id] = f.driver_name;\n}\n\nconst now = new Date().toTimeString().slice(0, 5); // HH:MM\n\nconst rows = flatRows\n  .filter(r => r.driver_id !== 'UNASSIGNED') // only real assignments go live\n  .map(r => ({\n    json: {\n      run_date: r.run_date,\n      driver_id: r.driver_id,\n      driver_name: nameLookup[r.driver_id] || 'UNKNOWN',\n      vehicle_id: r.vehicle_id,\n      sequence: r.sequence,\n      order_id: r.order_id,\n      stop_address: r.stop_address,\n      estimated_arrival: r.estimated_arrival,\n      whatsapp_sent_at: now\n    }\n  }));\n\nreturn rows;"

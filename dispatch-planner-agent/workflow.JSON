    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst orders = data.orders;\nconst fleet = data.fleet;\n\nconst systemInstructions = `You are a logistics dispatch planner for a courier company in Lagos, Nigeria.\n\nRULES:\n- Each vehicle's total assigned weight_kg must not exceed its capacity_kg.\n- Prefer assigning orders to the driver/vehicle whose current_zone matches the order's destination_area.\n- Respect each order's time_window_start and time_window_end — a driver should not be scheduled to arrive outside that window given their shift_start/shift_end.\n- Priority orders should be scheduled earlier in a driver's route than Standard orders when possible.\n- If an order cannot reasonably fit any vehicle (capacity, zone, or time conflict), do NOT force it — put it in \"unassigned\" instead.\n- Sequence stops within each route in a sensible order (group by proximity/zone, respect time windows).\n\nOUTPUT FORMAT:\nReturn ONLY valid JSON, no markdown fences, no explanation text, matching exactly this shape:\n{\n  \"routes\": [\n    {\n      \"driver_id\": \"string\",\n      \"vehicle_id\": \"string\",\n      \"stops\": [\n        { \"order_id\": \"string\", \"sequence\": 1, \"estimated_arrival\": \"HH:MM\" }\n      ]\n    }\n  ],\n  \"unassigned\": [\n    { \"order_id\": \"string\", \"reason\": \"string\" }\n  ],\n  \"notes\": \"string - any general observations about today's plan\"\n}`;\n\nconst promptText = `${systemInstructions}\n\nTODAY'S ORDERS:\n${JSON.stringify(orders, null, 2)}\n\nTODAY'S FLEET:\n${JSON.stringify(fleet, null, 2)}`;\n\nreturn [{ json: { promptText } }];"
      },
      "id": "bc2d45d1-c5b8-4668-9d19-639a6d76737e",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
